# Copy to .env and fill in your own values. Never commit .env.

# Claude (set a spend limit in the Anthropic console)
ANTHROPIC_API_KEY=

# myDATA (AADE) test environment
MYDATA_ENV=dev
MYDATA_USER_ID=
MYDATA_SUBSCRIPTION_KEY=
MYDATA_AFM=
# Second dev registration, playing the supplier (sends invoices to the store)
MYDATA_SUPPLIER_USER_ID=
MYDATA_SUPPLIER_SUBSCRIPTION_KEY=
MYDATA_SUPPLIER_AFM=

# Κωδικός ομάδας για όλο το site (όταν ανοίγει από tunnel). Κενός = χωρίς login, όπως τοπικά.
XANGX_ACCESS_CODE=
# Μυστικό για το cookie σύνδεσης. Κενό = βγαίνει από τον κωδικό ομάδας, ώστε τα κινητά να μένουν συνδεδεμένα μετά από επανεκκίνηση.
XANGX_SESSION_SECRET=

# 0 = ο συνεργάτης δεν ξεκινά μόνος του (ούτε πρωινός έλεγχος)· κενό = ξεκινά
XANGX_AUTORUN=

# Πόρτα MCP για άλλους agents (POST /mcp). Κενό ή κάτω από 24 χαρακτήρες = η πόρτα είναι κλειστή (404).
# Φτιάξε μακρύ τυχαίο κωδικό· ο agent τον στέλνει ως "Authorization: Bearer <κωδικός>". Δες docs/MCP.md.
XANGX_MCP_TOKEN=

# Telegram bot for owner notifications and approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Order emails to suppliers (empty: emails are written to data/outbox/ instead)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo only: every order email goes to this address (the "supplier" on stage)
XANGX_DEMO_SUPPLIER_EMAIL=

# Supplier replies to orders (empty: no mailbox is read). IMAP over SSL, port 993 by default.
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
